@page "/patient/{id}"
@using EnterpriseHealthcareDotNet.Models
@using EnterpriseHealthcareDotNet.Services
@inject MongoDBService MongoDbService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@(patient?.PatientName ?? "Patient Details")</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="patients">Patients</a></li>
        <li class="breadcrumb-item active" aria-current="page">@(patient?.PatientName ?? "Details")</li>
    </ol>
</nav>

@if (loading)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading...
    </div>
}
else if (patient == null)
{
    <div class="alert alert-warning">Patient not found. <a href="patients" class="alert-link">Back to patients</a></div>
}
else
{
    <div class="page-header">
        <h1 class="h3 mb-0">@(isEditMode ? "Edit Patient" : "Patient Details")</h1>
        <div class="d-flex gap-2">
            @if (isEditMode)
            {
                <button class="btn btn-success" @onclick="SaveChanges"><i class="bi bi-check-lg me-1"></i>Save</button>
                <button class="btn btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="() => isEditMode = true"><i class="bi bi-pencil me-1"></i>Edit</button>
            }
            <button class="btn btn-outline-danger" @onclick="DeletePatient"><i class="bi bi-trash me-1"></i>Delete</button>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-semibold">Patient Information</div>
        <div class="card-body">
            @if (isEditMode)
            {
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="name">Name</label>
                        <input id="name" class="form-control" @bind="patient.PatientName" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="dob">Date of Birth</label>
                        <input id="dob" type="date" class="form-control" @bind="patient.DateOfBirth" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="ssn">SSN</label>
                        <input id="ssn" class="form-control" autocomplete="off" @bind="patient.PatientRecord.SSN" />
                    </div>
                </div>
            }
            else
            {
                <dl class="row mb-0">
                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@patient.PatientName</dd>
                    <dt class="col-sm-3">Date of Birth</dt>
                    <dd class="col-sm-9">@patient.DateOfBirth?.ToString("MMM d, yyyy")</dd>
                    <dt class="col-sm-3">SSN</dt>
                    <dd class="col-sm-9 mb-0"><MaskedSsn Value="@patient.PatientRecord?.SSN" /></dd>
                </dl>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-semibold">Health Conditions</div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>Name</th><th>Date</th><th>Status</th>@if (isEditMode){<th class="text-end">Actions</th>}</tr>
                </thead>
                <tbody>
                    @if (patient.PatientRecord?.HealthConditions == null || !patient.PatientRecord.HealthConditions.Any())
                    {
                        <tr><td colspan="@(isEditMode ? 4 : 3)" class="text-muted text-center">No health conditions found.</td></tr>
                    }
                    else
                    {
                        @foreach (var condition in patient.PatientRecord.HealthConditions)
                        {
                            <tr>
                                @if (isEditMode)
                                {
                                    <td><input class="form-control form-control-sm" @bind="condition.Name" /></td>
                                    <td><input type="date" class="form-control form-control-sm" min="2000-01-01" @bind="condition.Date" /></td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="condition.Status">
                                            @foreach (var status in Enum.GetValues<Status>())
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-danger btn-sm" title="Delete condition" aria-label="Delete condition" @onclick="() => DeleteHealthCondition(condition)"><i class="bi bi-trash"></i></button>
                                    </td>
                                }
                                else
                                {
                                    <td>@condition.Name</td>
                                    <td>@condition.Date?.ToString("MMM d, yyyy")</td>
                                    <td><span class="badge @(condition.Status == Status.Active ? "text-bg-warning" : "text-bg-secondary")">@condition.Status</span></td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (isEditMode)
    {
        <div class="card mt-4">
            <div class="card-header fw-semibold">Add New Health Condition</div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <input class="form-control" @bind="newCondition.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" min="2000-01-01" @bind="newCondition.Date" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="newCondition.Status">
                            @foreach (var status in Enum.GetValues<Status>())
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-primary w-100" @onclick="AddHealthCondition"><i class="bi bi-plus-lg me-1"></i>Add</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Patient? patient;
    private bool loading = true;
    private bool isEditMode;
    private HealthCondition newCondition = new();

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        patient = string.IsNullOrEmpty(Id) ? null : await MongoDbService.GetPatientAsync(Id);
        loading = false;
    }

    private async Task CancelEdit()
    {
        isEditMode = false;
        patient = await MongoDbService.GetPatientAsync(Id);
    }

    private async Task SaveChanges()
    {
        if (patient != null)
        {
            await MongoDbService.UpdatePatientAsync(patient.Id.ToString(), patient);
            isEditMode = false;
        }
    }

    private async Task DeletePatient()
    {
        if (patient == null || !await JS.InvokeAsync<bool>("confirm", $"Delete {patient.PatientName}? This cannot be undone."))
            return;

        await MongoDbService.DeletePatientAsync(patient.Id.ToString());
        NavigationManager.NavigateTo("/patients");
    }

    private void AddHealthCondition()
    {
        if (patient != null && newCondition != null)
        {
            patient.PatientRecord.HealthConditions.Add(newCondition);
            newCondition = new HealthCondition(); // Reset the form
        }
    }

    private void DeleteHealthCondition(HealthCondition condition)
    {
        if (patient != null && patient.PatientRecord.HealthConditions.Contains(condition))
        {
            patient.PatientRecord.HealthConditions.Remove(condition);
        }
    }
}
