@page "/patients"
@using EnterpriseHealthcareDotNet.Models
@using EnterpriseHealthcareDotNet.Services
@using MongoDB.Bson
@inject PatientService PatientService
@inject IJSRuntime JS

<PageTitle>Patients</PageTitle>

<div class="page-header">
    <h1 class="h3 mb-0">Patients</h1>
    <a href="patients/add" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Add Patient</a>
</div>

@if (patients == null)
{
    <div class="text-center text-muted py-5">
        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Loading patients...
    </div>
}
else if (!patients.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-people display-5 text-muted"></i>
            <p class="text-muted mt-3">No patients found.</p>
            <a href="patients/add" class="btn btn-primary">Add your first patient</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Date of Birth</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in patients)
                    {
                        <tr>
                            <td class="fw-medium">@patient.PatientName</td>
                            <td>@patient.DateOfBirth?.ToString("MMM d, yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a href="patient/@patient.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-eye me-1"></i>View</a>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeletePatient(patient)"><i class="bi bi-trash me-1"></i>Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Patient>? patients;

    protected override void OnInitialized()
    {
        patients = PatientService.GetAllPatients();
    }

    private async Task DeletePatient(Patient patient)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {patient.PatientName}? This cannot be undone."))
            return;

        PatientService.DeletePatient(patient.Id.ToString());
        patients = PatientService.GetAllPatients();
    }
}
